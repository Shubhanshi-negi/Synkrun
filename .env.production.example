# ================================
# Synkrun — Production Environment
# ================================
# Copy to .env.production and fill in your values
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# Database
POSTGRES_URL=""

# Redis
REDIS_URL=''

# Better Auth - generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=''

# GitHub OAuth
BETTER_AUTH_GITHUB_ID=""
BETTER_AUTH_GITHUB_SECRET=""

# Google OAuth
BETTER_AUTH_GOOGLE_ID=""
BETTER_AUTH_GOOGLE_SECRET=""

# URLs
BASE_URL="https://your-domain.example"
PRODUCTION_URL="https://your-domain.example"

# Your own code execution service; there is no hosted default.
JUDGE_API_URL=""
JUDGE_API_TOKEN=""

# Public storage domain for uploaded images and snapshots.
R2_PUBLIC_URL=""
