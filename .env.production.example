# ================================
# Synkrun — Production Environment
# ================================
# Set these values in Vercel for the web app and in the relevant hosted
# services. Never commit real credentials.

# Database
POSTGRES_URL=""

# Redis
REDIS_URL=''

# Better Auth - generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=''

# GitHub OAuth
BETTER_AUTH_GITHUB_ID=""
BETTER_AUTH_GITHUB_SECRET=""

# Google OAuth
BETTER_AUTH_GOOGLE_ID=""
BETTER_AUTH_GOOGLE_SECRET=""

# Public URLs
BASE_URL="https://your-domain.example"
PRODUCTION_URL="https://your-domain.example"
NEXT_PUBLIC_BASE_URL="https://your-domain.example"
NEXT_PUBLIC_SOCKET_URL="wss://collaboration.your-domain.example"
ALLOWED_WS_ORIGINS="https://your-domain.example"

# Cloudflare R2 (required by the storage package)
R2_BUCKET=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"

# Your own code execution service; there is no hosted default.
JUDGE_API_URL=""
JUDGE_API_TOKEN=""

# Public storage domain for uploaded images and snapshots.
R2_PUBLIC_URL=""

# Optional
MISTRAL_API_KEY=""
NEXT_PUBLIC_UMAMI_SRC=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
